{# Single column, no tables for layout, standard fonts, real text.
   ATS parsers read the text layer — anything clever here costs the user a match. #}
<style>
  @page { size: Letter; margin: 0.6in 0.7in; }
  body {
    font-family: "Helvetica", "Arial", sans-serif;
    font-size: 10.5pt;
    line-height: 1.38;
    color: #111;
  }
  h1 { font-size: 18pt; margin: 0 0 2pt; letter-spacing: 0.2pt; }
  .contact { font-size: 9.5pt; color: #333; margin-bottom: 10pt; }
  .contact span + span::before { content: " · "; color: #999; }
  h2 {
    font-size: 10.5pt;
    text-transform: uppercase;
    letter-spacing: 0.8pt;
    border-bottom: 0.6pt solid #999;
    padding-bottom: 2pt;
    margin: 13pt 0 6pt;
  }
  .summary { margin: 0 0 2pt; }
  .role { margin-bottom: 9pt; }
  .role-head { font-weight: bold; }
  .role-meta { color: #444; font-size: 9.5pt; margin-bottom: 2pt; }
  ul { margin: 3pt 0 0; padding-left: 15pt; }
  li { margin-bottom: 2.5pt; }
  .skills { margin: 0; }
</style>

<h1>{{ facts.identity.name }}</h1>
<div class="contact">
  <span>{{ facts.identity.email }}</span>
  {%- if facts.identity.phone %}<span>{{ facts.identity.phone }}</span>{% endif %}
  {%- if facts.identity.location %}<span>{{ facts.identity.location }}</span>{% endif %}
  {%- if facts.links.linkedin %}<span>{{ facts.links.linkedin }}</span>{% endif %}
  {%- if facts.links.github %}<span>{{ facts.links.github }}</span>{% endif %}
</div>

{% if output.summary %}
<h2>Summary</h2>
<p class="summary">{{ output.summary }}</p>
{% endif %}

{% if skills %}
<h2>Skills</h2>
<p class="skills">{{ skills | join(" · ") }}</p>
{% endif %}

{% if facts.employment %}
<h2>Experience</h2>
{% for role in facts.employment %}
<div class="role">
  {# Employer, title, and dates come from canonical_facts, never from the model. #}
  <div class="role-head">{{ role.title }} — {{ role.company }}</div>
  <div class="role-meta">{{ role.start }} – {{ role.end }}</div>
  <ul>
    {% for bullet in bullets_by_role.get(loop.index0, role.bullets) %}
    <li>{{ bullet }}</li>
    {% endfor %}
  </ul>
</div>
{% endfor %}
{% endif %}

{% if facts.education %}
<h2>Education</h2>
{% for edu in facts.education %}
<div class="role">
  <div class="role-head">{{ edu.degree }}</div>
  <div class="role-meta">{{ edu.institution }} — {{ edu.year }}</div>
</div>
{% endfor %}
{% endif %}
