# Copy to .env and fill in. .env is gitignored — never commit real values.

# Postgres 17 + pgvector (installed via Homebrew; see README)
DATABASE_URL=postgresql+psycopg://localhost:5432/jobpilot

# NVIDIA NIM (OpenAI-compatible) — scoring, tailoring, and embeddings.
# Leave blank and set JOBPILOT_FIXTURE_MODE=1 to run the pipeline without it.
NVIDIA_API_KEY=

# Adzuna — aggregator discovery. Free tier: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Run the full pipeline against recorded fixtures instead of live APIs.
JOBPILOT_FIXTURE_MODE=1

# --- Models -----------------------------------------------------------------
# Chosen by benchmarking this account against the real schemas, not by
# reputation. nemotron-3-super answers both tasks in 8-79s; the previous
# tailoring default (gpt-oss-120b) took 106-180s and frequently timed out.
JOBPILOT_TAILORING_MODEL=nvidia/nemotron-3-super-120b-a12b
JOBPILOT_SCORING_MODEL=nvidia/nemotron-3-super-120b-a12b
JOBPILOT_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# --- Tuning dials -----------------------------------------------------------
JOBPILOT_MATCH_SCORE_THRESHOLD=70
JOBPILOT_MAX_TAILORED_PER_DAY=12
JOBPILOT_EMBED_TOP_K=40
JOBPILOT_MAX_POSTING_AGE_DAYS=30
JOBPILOT_MAX_YEARS_REQUIRED=8

# Estimated tokens per embedding input. The provider's hard cap is 512; the
# margin absorbs the estimate, which is a heuristic. Non-ASCII text costs ~2.5
# tokens per character, so Japanese and Korean postings trim much shorter.
JOBPILOT_EMBEDDING_TOKEN_BUDGET=380

# ---- Async runner (Phase A) -------------------------------------------------
# Celery broker and result backend. `brew services start redis` for local use.
JOBPILOT_REDIS_URL=redis://localhost:6379/0
# Run enqueued work inline with no broker. Blocks the caller — the thing the
# runner exists to avoid — so leave it off unless you cannot run Redis.
JOBPILOT_CELERY_TASK_ALWAYS_EAGER=0

# The nightly pipeline, run by `celery ... beat`. Start exactly one beat process.
JOBPILOT_NIGHTLY_RUN_ENABLED=1
JOBPILOT_NIGHTLY_RUN_HOUR=2
JOBPILOT_NIGHTLY_RUN_MINUTE=0
JOBPILOT_CELERY_TIMEZONE=Asia/Kolkata

# ---- API --------------------------------------------------------------------
# Browser origins allowed to call the API.
JOBPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Off by default: this is a localhost tool. Turn it ON before the port is
# reachable from anywhere else — until then anyone who can reach it can approve
# applications and download your resume. The API refuses to start if auth is on
# and the token is empty.
JOBPILOT_AUTH_ENABLED=0
JOBPILOT_API_TOKEN=

# Which `users` row owns this installation; `confirm-facts` writes it.
JOBPILOT_OWNER_EMAIL=owner@localhost
