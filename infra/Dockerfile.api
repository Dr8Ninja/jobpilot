# JobPilot API.
#
# Built and verified in CI, not on the dev machine — there is no Docker there
# (CLAUDE.md). Keep it that way round: if this file and CI disagree, CI is the
# one that actually runs.

FROM ghcr.io/astral-sh/uv:0.11-python3.13-bookworm-slim

# WeasyPrint renders the tailored PDF. Since v53 it writes PDFs itself and no
# longer needs cairo, but it still lays text out through Pango — and without a
# font package it produces a page of blank boxes rather than an error.
RUN apt-get update && apt-get install --no-install-recommends -y \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libharfbuzz0b \
        libfribidi0 \
        shared-mime-info \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Dependencies resolve from the lockfile in their own layer, so a source-only
# change does not re-download the world.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY packages ./packages
COPY services ./services
COPY migrations ./migrations
COPY alembic.ini ./
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH"

# Tailored PDFs are written to disk and their path is stored in the database, so
# this must be a volume in any real deployment or approved resumes vanish with
# the container. Object storage is the proper fix and is not Phase A.
RUN useradd --create-home --uid 10001 jobpilot \
    && mkdir -p /app/storage/resumes \
    && chown -R jobpilot:jobpilot /app/storage
USER jobpilot
VOLUME ["/app/storage"]

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
    CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health').read()"

CMD ["uvicorn", "jobpilot_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
